# Copy to .env in the repository root. Never commit your real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENVIRONMENT=development
# Defaults below are for host processes. Compose overrides service hostnames.
DATABASE_URL=postgresql+psycopg://linguatrack_app:local_app@localhost:5433/linguatrack
MIGRATION_DATABASE_URL=postgresql+psycopg://linguatrack:local_admin@localhost:5433/linguatrack
REDIS_URL=redis://localhost:6380/0
